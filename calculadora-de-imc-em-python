altura = float(input("digite a altura (em cm): "))
peso = float(input("digite o peso (em kg): "))



imc = peso / (altura**2)

print(f"o imc é: {imc:.1f}")

if imc < 18.5:
  print("desnutrição")
elif 18.5 <= imc < 24.9:
  print("saudavel")
elif 25 <= imc < 29.9:
  print("sobrepeso")
elif imc >= 30:
  print("obeso")
